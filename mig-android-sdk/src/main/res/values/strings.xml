    <string name="junior_league_description">Esports Series Madrid</string>
    <string name="junior_league_overview">The equivalent of Esports Series Madrid for schools and high schools in the city. The ESM Junior Esports is your entry point to participate with your educational center in the junior municipal league of League of Legends and Rocket League.</string>
    <string name="storm_circuit_title">Storm Circuit</string>
    <string name="storm_circuit_description">Esports Series Madrid</string>
